{
  "name": "gridsy",
  "version": "0.2.1",
  "description": "A TypeScript library for rendering and exporting high-DPI image grids.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run format:check && npm run build",
    "demo:dev": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build"
  },
  "keywords": [
    "canvas",
    "image-grid",
    "typescript"
  ],
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetomerv/gridsy.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetomerv/gridsy/issues"
  },
  "homepage": "https://github.com/ahmetomerv/gridsy#readme"
}
